# ==============================================================================
# AR ASSISTANT // CONFIGURATION TEMPLATE
# Copy this file to .env and insert your Gemini API Key below.
# Get your Gemini API Key at: https://aistudio.google.com/
# ==============================================================================

# Google Gemini API Key (Required for Multimodal Live)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model
# Multimodal Live WebSocket model
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Screen Observation
# Snapshot interval in seconds (default: 1.0s discrete frame)
SNAPSHOT_INTERVAL=1.0
SCREEN_FPS=1.0
SCREEN_JPEG_QUALITY=70
SCREEN_MAX_WIDTH=1280
SCREEN_MAX_HEIGHT=720

# Audio Configuration
SAMPLE_RATE_IN=16000
SAMPLE_RATE_OUT=24000
AUDIO_CHANNELS=1

# Voice Persona: Aoede, Charon, Fenrir, Kore, Puck
VOICE_NAME=Puck

# Memory Persistence Directory
MEMORY_DIR=.memory
